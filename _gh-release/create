#!/usr/bin/env bash

function info.prepareHelp() {
    echo
    echo "gh-release ${green}create$reset - Creates release on GitHub."
    echo "    It takes last two tags and create template on GitHub."
    echo "    After edit release on GitHub (add ChangLog) and publish it."
    echo
    echo "${yellow}Usage$reset:"
    echo "    gh-release create"
    echo
}

if [[ $# -gt 0 ]]; then
    while read option; do
        case ${option} in
            -h|--help) info.prepareHelp; exit;;
            *) info.error "Unknown option $option"; info.prepareHelp; exit 2; ;;
        esac
    done <<< $(for i in "$@"; do echo "$i"; done);
fi

function getRepoApiUrl() {
    git config --get remote.${remote}.url |
    sed 's|^git@github.com:|https://api.github.com/repos/|' |
    sed 's|\.git$||';
}
function getRepoUrl() {
    git config --get remote.${remote}.url |
        sed 's|^git@github.com:|https://github.com/|' |
        sed 's|\.git||';
}

# Takes the already-written (and possibly hand-edited) section for `## [<version>]...`
# from the ChangeLog file, instead of regenerating it from `git log`.
# Prints nothing (and returns 1) if no such section is found.
function getChangeLogSection() {
    local ver=$1
    local startLine=`grep -Fn "## [${ver}]" "${changeLogFile}" | head -1 | cut -d: -f1`
    if [[ -z ${startLine} ]]; then
        return 1;
    fi

    local endLine=`tail -n +"$((startLine+1))" "${changeLogFile}" | grep -n '^## ' | head -1 | cut -d: -f1`
    if [[ -n ${endLine} ]]; then
        endLine=$((startLine + endLine - 1));
    else
        endLine=`wc -l < "${changeLogFile}"`;
    fi

    sed -n "$((startLine+1)),${endLine}p" "${changeLogFile}" | sed '/^$/d';
}

tag2=$(git describe --tags --abbrev=0)
tag1=$(git describe --tags --abbrev=0 "${tag2}~1" 2>/dev/null)

compareLink="### [View Commits](`getRepoUrl`/commits/${tag2})";
if [[ ${tag1} != '' ]]; then
    compareLink="### [View Commits](`getRepoUrl`/compare/${tag1}...${tag2})";
fi

repoUrl=`getRepoUrl`
messages=`getChangeLogSection "${tag2}"`;
if [[ -z ${messages} ]]; then
    c.warning "No entry for [${tag2}] found in ${changeLogFile} — falling back to \`git log\`.";
    range="${tag2}"; # no previous tag (first ever release) -> full history up to tag2
    if [[ ${tag1} != '' ]]; then
        range="${tag1}..${tag2}";
    fi
    messages=`git --no-pager log ${range} --oneline --reverse | cut -f 2- -d ' ' | sed 's/^/ - /'`;
fi
desc=`echo -e "## Change Log:\n\n${messages}\n\n### [View full changes](${repoUrl}/blob/master/CHANGELOG.md#$tag2)\n${compareLink}"`

echo $tag1
echo $tag2
echo "$desc"





c.header ' Create release on GitHub: ';

gh release create $tag2 --draft --title $tag2 --notes "$desc"



