#!/usr/bin/env bash

commit=''
version=`date +'%Y.%m'`
folder=''

function info.prepareHelp() {
    echo
    echo "gh-release ${green}prepare$reset - Collect commit messages and prepend to ChangLog file."
    echo "    It takes all commits from latest tag to current latest commit (or to specified commit in '-c' option)."
    echo "    Before continue with 'gh-release version' you can edit your prepared ChangLog file."
    echo "    If config \`submodulesLog\` is enabled, also adds an entry with commit messages of changed submodules."
    echo
    echo "${yellow}Usage$reset:"
    echo "    gh-release prepare ${green}[${reset}{-c|--commit} <commit_hash>${green}]${reset} ${green}[${reset}{-v|--version|-t|--tag} <tag>${green}]${reset} ${green}[${reset}{-f|--folder} <folder>${green}]${reset}"
    echo
    echo "${yellow}Options$reset:"
    echo "    ${green}-c|--commit            <commit_hash>$reset       ${yellow}[default: latest ]$reset The commit to take ${bold}to$reset."
    echo "    ${green}-v|--version|-t|--tag  <tag>$reset               ${yellow}[default: YYYY.MM]$reset Specified tag will be used to generate link in ChangeLog file."
    echo "    ${green}-f|--folder            <folder>$reset            ${yellow}[default: none   ]$reset Only take commits touching ${bold}<folder>$reset, and prepend to ${bold}<folder>/CHANGELOG.md$reset instead of the repo's root one."
    echo
}

while read option; do
    case ${option} in
        -c|--commit) read commit;;
        -v|--version) read version;;
        -t|--tag) read version;;
        -f|--folder) read folder;;
        -h|--help) info.prepareHelp; exit;;
        '') continue;;
        *) info.error "Unknown option $option"; info.prepareHelp; exit 2; ;;
    esac
done <<< $(for i in "$@"; do echo "$i"; done);



function getGitMessages() {
    local showCommand=$1

    local from=`git describe --tags --abbrev=0 2>/dev/null`;
    local to=${commit}
    local range="${to}"; # no tags yet -> take everything from the start
    if [[ ${from} != '' ]]; then
        range="${from}..${to}";
    fi
    local pathFilter='';
    if [[ ${folder} != '' ]]; then
        pathFilter="-- ${folder}";
    fi

    if [[ ${submodulesLog} == 1 ]]; then
        local gitCommand="git --no-pager log --reverse --format='%C(auto,yellow)%h%C(auto,reset) %w(0,0,8)%s%n%b' ${range} ${pathFilter}"
    else
        local gitCommand="git --no-pager log ${range} --oneline --reverse ${pathFilter}"
    fi
    if [ $showCommand ]; then
        echo "$gitCommand"
    fi
    eval "$gitCommand"
}

function getChangeLogTarget() {
    if [[ ${folder} == '' ]]; then
        echo "${changeLogFile}";
        return;
    fi
    if [[ -f "${folder}/CHANGELOG.md" ]]; then
        echo "${folder}/CHANGELOG.md";
        return;
    fi
    echo "${folder}/changelog.md"; # default, also used if it doesn't exist yet
}

function getRepoUrl() {
    git config --get remote.${remote}.url |
        sed 's|^git@github.com:|https://github.com/|' |
        sed 's|\.git||';
}

function formatCommitMessages() {
    sed '/^$/d' |                 # drop blank lines
    sed -E 's/^[0-9a-f]+ / - /' | # commit-hash -> bullet
    sed '/^ - /!s/^     //'       # everything else -> trim git's 8-space %w indent down to 3
}

function makeChangeLog() {
    local commitsList=$1;
    local repoUrl=`getRepoUrl`;

    echo "## [$version]($repoUrl/releases/tag/$version)"
    echo "$commitsList" | formatCommitMessages
    echo
}
function file.InsertAfterNLines() {
    local file="$1";
    local text="$2";
    local linesCount="$3";

    head "$file" -n "$linesCount"        >  tmp.md;  # first N lines
    echo -e "$text\n"                    >> tmp.md;  # add new change-log
    tail "$file" -n +"$((linesCount+1))" >> tmp.md;  # add other old lines

    cat tmp.md > "$file";
    rm tmp.md;
}

c.header ' Found commits: ';
getGitMessages true; # just output found commits (with hashes) by 'git log'

c.header ' Prepending to Change Log: ';
messages=`getGitMessages`;
changLog=`makeChangeLog "${messages}"`;
echo "${changLog}" |
    sed "s/^## \(\[${version/\./\\.}\]\)\(.*\)\$/${cyan}## ${green}\\1${cyan}\\2${reset}/" |
    sed "s/^ - \(.*\)\$/${green} - ${reset}\\1/";
echo

target=`getChangeLogTarget`;
if [[ ! -f "$target" ]]; then
    echo -e "# Change Log\n" > "$target";
fi

c.askContinue "Continue with prepend this to $target";
file.InsertAfterNLines "$target" "$changLog" 2;
